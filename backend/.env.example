PORT=4000
CLIENT_ORIGIN=http://localhost:5174
NODE_ENV=development

DB_SERVER=localhost
DB_NAME=qr_menu
DB_USER=sa
DB_PASSWORD=

JWT_SECRET=change-this-to-a-long-random-string

SEED_ADMIN_EMAIL=admin@qrmenu.local
SEED_ADMIN_PASSWORD=change-this-password

# Restoranın yerli vaxt qurşağı (UTC-dən saat fərqi) — dashboard gün sərhədləri üçün
TZ_OFFSET_HOURS=4

# Admin sessiyasının müddəti (saat) — defolt 12
ADMIN_SESSION_HOURS=12

# npm run backup üçün: SQL Server-in işlədiyi maşında yazıla bilən qovluq (boşdursa SQL Server-in defolt backup yolu)
# BACKUP_DIR=D:\Backups
# BACKUP_RETENTION_DAYS=14
