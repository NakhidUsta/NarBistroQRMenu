PORT=4000
CLIENT_ORIGIN=http://localhost:5174
NODE_ENV=development

DB_SERVER=localhost
DB_NAME=qr_menu
DB_USER=sa
DB_PASSWORD=

JWT_SECRET=change-this-to-a-long-random-string

SEED_ADMIN_EMAIL=admin@qrmenu.local
SEED_ADMIN_PASSWORD=change-this-password

# Restoranın yerli vaxt qurşağı (UTC-dən saat fərqi) — dashboard gün sərhədləri üçün
TZ_OFFSET_HOURS=4

# Admin sessiyası: refresh token-in boş qalma müddəti (saat), mütləq ömür (gün) və access token ömrü (dəq)
ADMIN_SESSION_HOURS=12
ADMIN_SESSION_MAX_DAYS=7
ACCESS_TOKEN_MINUTES=15

# Xəta jurnalı qovluğu (defolt: backend/logs)
# LOG_DIR=./logs

# Domen (OG/sitemap/robots üçün) və qurulmuş frontend qovluğu — production-da
# PUBLIC_URL=https://menu.example.az
# FRONTEND_DIST=../frontend/dist

# npm run backup üçün: SQL Server-in işlədiyi maşında yazıla bilən qovluq (boşdursa SQL Server-in defolt backup yolu)
# BACKUP_DIR=D:\Backups
# BACKUP_RETENTION_DAYS=14

# E-poçt (Gmail SMTP) — şifrə sıfırlama və e-poçt təsdiqi üçün. Gmail-də 2 addımlı doğrulama + "Tətbiq şifrəsi" (App Password) lazımdır:
# https://myaccount.google.com/apppasswords   (adi Gmail şifrəsi işləmir!)
# SMTP_USER=restoran@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM="Savora <restoran@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Yalnız DEV: məktub göndərmədən konsola yaz (tokenli link daxil) — production-da işlətməyin
# MAIL_DRIVER=console

# Ümumi API sorğu limiti (IP üzrə, 15 dəq). Restoran Wi-Fi-ında hamı bir IP paylaşır — yüksək saxlayın
# RATE_LIMIT_GENERAL=3000
